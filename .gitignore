# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/

# macOS
.DS_Store
._*
.AppleDouble

# Claude Code personal scope (never commit)
CLAUDE.local.md
.claude/settings.local.json

# Test corpus — large binaries and (potentially sensitive) real samples.
# Track generators/manifests, not the files themselves.
tests/corpus/originals/
tests/corpus/scrubbed/
tests/corpus/**/*.jpg
tests/corpus/**/*.jpeg
tests/corpus/**/*.png
tests/corpus/**/*.pdf
tests/corpus/**/*.docx
tests/corpus/**/*.mp4
tests/corpus/**/*.mp3
tests/corpus/**/*.heic
tests/corpus/**/*.raw
tests/corpus/**/*.cr2
tests/corpus/**/*.cr3
tests/corpus/**/*.nef
tests/corpus/**/*.arw
tests/corpus/**/*.dng

# Real / personal test images anywhere in the repo — potentially sensitive
# (passports, selfies, GPS-tagged photos). Never commit the binaries; track
# only generators, manifests, and result JSON. Force-add a genuinely needed
# doc image with `git add -f`.
*.jpg
*.jpeg
*.JPG
*.JPEG
*.png
*.PNG
*.heic
*.HEIC
*.tif
*.tiff
*.webp
*.gif
# Ad-hoc scrub scratch files at the repo root (test_*.JPG, *_clean.jpg, etc.)
/test_*
*_clean.*
*_TOOL.*

# Real-seed corpus lives outside the repo (~/metadata-research/); this guards
# against a copy ever landing inside it.
**/originals/
**/scrubbed/

# E3 peer-corpus images: present on disk, never committed (real photos, some with
# visible personal content). Only the folder's README is tracked.
tests/corpus/e3/*.jpg
tests/corpus/e3/*.jpeg
!tests/corpus/e3/README.md

# Scratch / reports
scratch/
*.log

# CI artifacts. Every one of these is regenerated by .github/workflows/ci.yml
# (or by running the same commands locally, see the README) — none of them is
# a source of truth, so none belongs in git.
.coverage
.coverage.*
coverage.json
coverage.xml
coverage-table.md
htmlcov/
pytest-results*.xml
junit/
timing/
ruff.json
actionlint.txt
evidence.json
qa-summary.md
qa-pr-comment.md
scrub-samples/
.ci-local/
